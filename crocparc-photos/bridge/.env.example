# ---------------------------------------------------------------------------
# Pont Croc Parc Photos - configuration
# Source unique de verite : tout se regle ici, rien n'est code en dur ailleurs.
# Copier en .env et adapter. Les variables deja presentes dans l'environnement
# du systeme ont la priorite sur ce fichier.
# ---------------------------------------------------------------------------

# --- Dossiers ---------------------------------------------------------------
# Dossier ou le Sony A7 IV depose ses JPEG via FTP (cible de FileZilla Server).
# Seul chemin obligatoire. Sur Windows : WATCH_DIR=C:/crocparc/ftp-in
# Les slashs avant fonctionnent aussi bien que les antislashs.
WATCH_DIR=./data/inbox
# Racine des donnees du pont (file SQLite, logs, archives, sortie).
BRIDGE_DATA_DIR=./data
# Archive des originaux pleine resolution. C'est la copie de reference : elle
# n'est jamais purgee automatiquement, et c'est d'ici que partent les fichiers
# vendus. Sur Windows : ORIGINALS_DIR=C:/crocparc/originals
ORIGINALS_DIR=./data/originals
# Chemins derives de BRIDGE_DATA_DIR si non renseignes :
# BRIDGE_DB_PATH=./data/bridge.db
# BRIDGE_WORK_DIR=./data/work
# BRIDGE_OUTPUT_DIR=./data/out
# BRIDGE_LOG_DIR=./data/logs

# --- Detection de fichier stable --------------------------------------------
# Taille inchangee pendant N secondes = fichier completement ecrit par le FTP.
BRIDGE_STABLE_SECONDS=2.0
# Periode de la boucle de travail (secondes).
BRIDGE_POLL_INTERVAL=1.0
# Balayage complet de l'inbox, filet de securite si watchdog rate un evenement.
BRIDGE_RESCAN_INTERVAL=30
# Extensions traitees (le RAW reste sur la carte, cible JPEG uniquement).
BRIDGE_EXTENSIONS=.jpg,.jpeg
# Effacement des originaux de l'inbox une fois archives et deposes.
# 0 = ne rien effacer. L'archive locale, elle, n'est jamais purgee par le pont.
WATCH_RETENTION_DAYS=15
# Periode de passage du menage (secondes).
BRIDGE_PURGE_INTERVAL=3600
# Delai avant de ranger une photo dans une session. Le FTP livre normalement
# dans l'ordre de prise de vue, mais une reprise apres echec peut faire arriver
# une photo avant la carte qui la precede : rangee tout de suite, elle
# atterrirait dans la galerie du groupe precedent. Le visiteur consulte ses
# photos des heures plus tard, ces deux minutes ne coutent rien.
BRIDGE_ASSIGN_GRACE_SECONDS=120

# --- Reprise sur erreur ------------------------------------------------------
BRIDGE_BASE_BACKOFF=5
BRIDGE_MAX_BACKOFF=300
# Nombre d'echecs consecutifs avant mise en quarantaine (visible en admin).
BRIDGE_MAX_ATTEMPTS=10

# --- Images ------------------------------------------------------------------
PREVIEW_MAX_EDGE=2048
PREVIEW_QUALITY=82
THUMB_MAX_EDGE=512
THUMB_QUALITY=75
WATERMARK_TEXT=CROC PARC
# Opacite du texte. 0.5 se laisse effacer trop facilement, 0.75 masque les
# visages et tue la vente : 0.65 est le compromis retenu apres essais.
WATERMARK_OPACITY=0.65
# Taille du texte, en fraction du bord court : meme presence sur une preview
# 2048 px et sur une vignette 512 px.
WATERMARK_SCALE=0.06
# Ecart entre deux marques, en multiples de la taille du texte. Plus petit =
# maillage plus serre, donc plus difficile a recadrer ou a effacer.
WATERMARK_SPACING=0.85
# Police du filigrane. Vide = police systeme detectee automatiquement.
WATERMARK_FONT=
# Bord long de l'image reduite utilisee pour chercher le QR code.
QR_SCAN_MAX_EDGE=1024

# --- Sessions ----------------------------------------------------------------
# Base d'URL encodee dans les QR des cartes.
GALLERY_BASE_URL=https://photos.crocparc.re/g/
# Duree de vie d'une session avant purge.
SESSION_TTL_DAYS=30
# La Reunion : UTC+4 toute l'annee, pas d'heure d'ete.
BRIDGE_TZ_OFFSET=+04:00
# Optionnel : CSV "code,card_number" produit par tools/generate-cards.py.
# Sert a retrouver le numero d'inventaire physique d'une carte.
CARDS_INVENTORY_CSV=

# --- Sortie ------------------------------------------------------------------
# Ou vont les previews et vignettes.
#   local = dossier BRIDGE_OUTPUT_DIR, arborescence identique a R2 (hors ligne)
#   r2    = Cloudflare R2
BRIDGE_STORAGE_BACKEND=local
# Ou est declaree la session.
#   none = nulle part, la charge utile est seulement journalisee
#   api  = POST /api/ingest
BRIDGE_REGISTRAR_BACKEND=none
BRIDGE_PREVIEWS_BUCKET=crocparc-previews
BRIDGE_ORIGINALS_BUCKET=crocparc-originals

# --- Liaison avec Cloudflare -------------------------------------------------
# Secret partage avec les Functions. Le meme sert dans les deux sens : le pont
# signe /api/ingest, les Functions signent /fetch-original.
# Generer avec : openssl rand -hex 32   (32 caracteres minimum)
# Cote Cloudflare : npx wrangler pages secret put BRIDGE_SHARED_SECRET
BRIDGE_SHARED_SECRET=
BRIDGE_INGEST_URL=https://photos.crocparc.re/api/ingest
BRIDGE_HTTP_TIMEOUT=30

# Identifiants R2 (API S3). A creer dans le tableau de bord Cloudflare,
# rubrique R2 -> Manage API tokens. L'endpoint ressemble a
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Endpoint des originaux vendus -------------------------------------------
# Les originaux du A7 IV pesent 10 a 20 Mo : ils restent au parc et ne montent
# sur R2 qu'une fois achetes, quand le webhook Stripe appelle cet endpoint.
# Il ne demarre que si BRIDGE_SHARED_SECRET est renseigne.
# A exposer par un tunnel Cloudflare, pas par une redirection de port.
BRIDGE_FETCH_HOST=127.0.0.1
BRIDGE_FETCH_PORT=8788

# --- Inventaire des cartes ---------------------------------------------------
# CSV produit par tools/generate-cards.py. Facultatif : il ne sert qu'a
# retrouver le numero d'inventaire physique d'une carte pour la console.
# CARDS_INVENTORY_CSV=./cartes/inventaire.csv

# --- Supervision -------------------------------------------------------------
BRIDGE_HEALTH_HOST=127.0.0.1
BRIDGE_HEALTH_PORT=8787
# debug | info | warning | error
BRIDGE_LOG_LEVEL=info
BRIDGE_LOG_MAX_BYTES=5242880
BRIDGE_LOG_BACKUPS=5
